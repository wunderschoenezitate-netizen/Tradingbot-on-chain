# --- Börse & Markt ---------------------------------------------------------
# binance | bybit
EXCHANGE=binance
SYMBOL=SOLUSDC
# Optional: eigene Websocket-URL (Standard wird aus EXCHANGE + SYMBOL abgeleitet)
# WS_URL=wss://stream.binance.com:9443/ws/solusdc@bookTicker

# --- Betriebsmodus ---------------------------------------------------------
# true = Paper-Trading (Fills werden über den Live-Preisstream simuliert)
DRY_RUN=true
PAPER_START_QUOTE=1000

# --- Grid ------------------------------------------------------------------
GRID_LEVELS_PER_SIDE=10
# Abstand zwischen zwei Levels in %. Muss > Mindestabstand nach Fees sein,
# bei 0.1 % Fee + 0.05 % Mindestgewinn also > 0.2503 %.
GRID_SPACING_PCT=0.5
# USDC je Grid-Level
ORDER_SIZE_QUOTE=25
MAKER_FEE_PCT=0.1
TAKER_FEE_PCT=0.1
MIN_NET_PROFIT_PCT=0.05
# Tick-/Lot-Size der Börse für das Symbol
PRICE_TICK=0.01
QTY_STEP=0.001
MIN_NOTIONAL=5
# Grid nach oben nachziehen, wenn der Preis über die Range ausbricht
RECENTER_ON_BREAKOUT=true

# --- Discord ---------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY
DISCORD_USERNAME=SOL Grid Bot

# --- API-Keys (nur für einen späteren Live-Modus, im Dry-Run nicht nötig) ---
API_KEY=
API_SECRET=

# --- Sonstiges -------------------------------------------------------------
# Reconnect, wenn so lange keine Marktdaten kommen
FEED_TIMEOUT_SECS=30
# error | warn | info | debug (debug zeigt die Tick→Fill-Latenz)
RUST_LOG=info
